{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniSCP",
  "version": "0.1.0",
  "identifier": "com.guillaumechantraine.omniscp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniSCP",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Guillaume Chantraine",
    "copyright": "© 2026 Guillaume Chantraine. GPL-3.0-or-later.",
    "homepage": "https://github.com/slone/OmniSCP",
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "SFTP and SCP client",
    "longDescription": "Cross-platform SFTP and SCP client with a dual-pane file browser, a transfer queue and folder synchronization.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
